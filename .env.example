# Blank credentials run an explicitly labelled sample place weather on the map.
# Set live to require credentials and never fall back to samples on failure.
WEATHER_MODE=demo
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# Separate browser credential restricted to the actual widget domain/namespace.
# Never copy an unrestricted server secret here.
XWEATHER_MAPSGL_CLIENT_ID=
XWEATHER_MAPSGL_CLIENT_SECRET=
# Set true only after configuring/verifying the restriction in Xweather.
XWEATHER_MAPSGL_RESTRICTED=false
