{
  "name": "xweather-mapsgl",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "Map-only Xweather Storm Explorer MCP App with live storm cells, lightning, forecast layers and location exposure",
  "author": "Manufact",
  "license": "MIT",
  "homepage": "https://github.com/manufacts/mcp-xweather-template",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/smoke.ts",
    "styles": "tailwindcss -i views/shared/fluid.input.css -o views/shared/fluid.css --minify",
    "predev": "npm run prepare:assets && npm run styles",
    "prebuild": "npm run prepare:assets && npm run styles",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@xweather/mapsgl": "1.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.1",
    "framer-motion": "13.4.0",
    "lucide-react": "0.562.0",
    "maplibre-gl": "6.10.0",
    "mcp-use": "2.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}
